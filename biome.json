{
	"$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
	"files": {
		"includes": [
			"app/**/*.ts",
			"app/**/*.tsx",
			"components/**/*.ts",
			"components/**/*.tsx",
			"hooks/**/*.ts",
			"hooks/**/*.tsx",
			"lib/**/*.ts",
			"ai/**/*.ts",
			"scripts/**/*.mjs",
			"**/*.test.ts",
			"**/*.test.tsx",
			"test/**/*.ts"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": false
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	}
}
